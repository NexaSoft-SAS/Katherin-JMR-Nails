---
const services = [
    {
        title: "Uñas Acrílicas",
        description:
            "Extensiones duraderas y resistentes con acabado natural o artístico. Ideales para uñas largas y elegantes.",
        price: "Desde $60.000",
        duration: "2-3 horas",
        icon: "💅",
        features: [
            "Alta durabilidad",
            "Diseños personalizados",
            "Reparación incluida",
        ],
    },
    {
        title: "Uñas de Gel",
        description:
            "Acabado brillante y flexible con gel de alta calidad. Perfecto para un look natural con fortaleza extra.",
        price: "Desde $50.000",
        duration: "1.5-2 horas",
        icon: "✨",
        features: ["Brillo duradero", "Fortalece la uña", "Secado rápido"],
    },
    {
        title: "Semipermanentes",
        description:
            "Esmalte de larga duración con secado LED. Color intenso que dura semanas sin descascararse.",
        price: "Desde $35.000",
        duration: "1-1.5 horas",
        icon: "💖",
        features: ["Dura 2-3 semanas", "Sin daño", "Colores vibrantes"],
    },
    {
        title: "Permanentes",
        description:
            "El clásico esmaltado profesional con productos de alta calidad para un acabado impecable.",
        price: "Desde $25.000",
        duration: "45 min - 1 hora",
        icon: "🌸",
        features: [
            "Acabado profesional",
            "Variedad de colores",
            "Hidratación incluida",
        ],
    },
];

const whatsappNumber = "573052348801";
---

<section id="servicios" class="section bg-gradient-to-b from-white to-pink-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center scroll-animate">
            <span
                class="inline-block px-4 py-2 bg-purple-100 text-purple-600 rounded-full text-sm font-medium mb-4"
            >
                Nuestros Servicios
            </span>
            <h2 class="section-title">
                Servicios de <span class="gradient-text">Manicure</span> Profesional
            </h2>
            <p class="section-subtitle">
                Cada servicio incluye limpieza, cuticula e hidratación.
                Productos de alta calidad para resultados duraderos.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                services.map((service, index) => (
                    <div
                        class="card p-6 scroll-animate group"
                        style={`animation-delay: ${index * 0.1}s`}
                    >
                        <div class="text-4xl mb-4">{service.icon}</div>

                        <h3 class="text-xl font-semibold text-gray-800 mb-2 group-hover:text-pink-500 transition-colors">
                            {service.title}
                        </h3>

                        <p class="text-gray-600 text-sm mb-4 leading-relaxed">
                            {service.description}
                        </p>

                        <ul class="space-y-2 mb-6">
                            {service.features.map((feature) => (
                                <li class="flex items-center gap-2 text-sm text-gray-500">
                                    <svg
                                        class="w-4 h-4 text-pink-400 flex-shrink-0"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                    {feature}
                                </li>
                            ))}
                        </ul>

                        <div class="border-t border-gray-100 pt-4">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-2xl font-bold gradient-text">
                                    {service.price}
                                </span>
                                <span class="text-xs text-gray-400">
                                    {service.duration}
                                </span>
                            </div>

                            <a
                                href={`https://wa.me/${whatsappNumber}?text=Hola%20Katherin,%20me%20interesa%20el%20servicio%20de%20${encodeURIComponent(service.title)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block w-full text-center btn-primary text-sm py-3"
                            >
                                Agendar Cita
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="text-center mt-12 scroll-animate">
            <p class="text-gray-500 text-sm">
                ¿Tienes dudas sobre qué servicio elegir?
                <a
                    href={`https://wa.me/${whatsappNumber}?text=Hola%20Katherin,%20necesito%20asesoría%20sobre%20qué%20tipo%20de%20manicure%20es%20mejor%20para%20mí`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-pink-500 hover:text-pink-600 font-medium underline"
                >
                    Escríbeme y te asesoro
                </a>
            </p>
        </div>
    </div>
</section>
