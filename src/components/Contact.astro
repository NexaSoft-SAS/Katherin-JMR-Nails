---
const whatsappNumber = "573052348801";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=Hola%20Katherin,%20me%20gustaría%20agendar%20una%20cita`;

const contactInfo = [
    {
        icon: "phone",
        title: "WhatsApp",
        value: "+57 305 234 8801",
        link: whatsappLink,
    },
    {
        icon: "location",
        title: "Zona de Servicio",
        value: "Bogotá y Soacha",
        link: null,
    },
    {
        icon: "clock",
        title: "Horario",
        value: "Lun - Sáb: 8am - 7pm",
        link: null,
    },
];
---

<section id="contacto" class="section bg-gradient-to-b from-white to-pink-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center scroll-animate">
            <span
                class="inline-block px-4 py-2 bg-pink-100 text-pink-600 rounded-full text-sm font-medium mb-4"
            >
                Contáctame
            </span>
            <h2 class="section-title">
                ¿Lista para lucir unas <span class="gradient-text"
                    >Uñas Increíbles</span
                >?
            </h2>
            <p class="section-subtitle">
                Agenda tu cita por WhatsApp y recibe atención personalizada.
                Servicio a domicilio disponible en Bogotá y Soacha.
            </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-10 max-w-5xl mx-auto">
            <!-- Contact Info -->
            <div class="scroll-animate space-y-6">
                {
                    contactInfo.map((info, index) => (
                        <div
                            class="card p-6 flex items-center gap-4"
                            style={`animation-delay: ${index * 0.1}s`}
                        >
                            <div class="w-14 h-14 rounded-full gradient-pink-lila flex items-center justify-center flex-shrink-0">
                                {info.icon === "phone" && (
                                    <svg
                                        class="w-6 h-6 text-white"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        />
                                    </svg>
                                )}
                                {info.icon === "location" && (
                                    <svg
                                        class="w-6 h-6 text-white"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                        />
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                        />
                                    </svg>
                                )}
                                {info.icon === "clock" && (
                                    <svg
                                        class="w-6 h-6 text-white"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                        />
                                    </svg>
                                )}
                            </div>
                            <div>
                                <p class="text-sm text-gray-500">
                                    {info.title}
                                </p>
                                {info.link ? (
                                    <a
                                        href={info.link}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-lg font-semibold text-gray-800 hover:text-pink-500 transition-colors"
                                    >
                                        {info.value}
                                    </a>
                                ) : (
                                    <p class="text-lg font-semibold text-gray-800">
                                        {info.value}
                                    </p>
                                )}
                            </div>
                        </div>
                    ))
                }

                <!-- Service Zones Map Placeholder -->
                <div
                    class="card p-4 scroll-animate"
                    style="animation-delay: 0.3s;"
                >
                    <div
                        class="aspect-video rounded-lg bg-gradient-to-br from-pink-100 to-purple-100 flex items-center justify-center"
                    >
                        <div class="text-center">
                            <svg
                                class="w-12 h-12 text-pink-400 mx-auto mb-2"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                                ></path>
                            </svg>
                            <p class="text-pink-600 font-medium text-sm">
                                Servicio a Domicilio
                            </p>
                            <p class="text-pink-500 text-xs">Bogotá • Soacha</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Card -->
            <div class="scroll-animate" style="animation-delay: 0.2s;">
                <div
                    class="card p-8 text-center bg-gradient-to-br from-pink-500 to-purple-600 text-white"
                >
                    <div
                        class="w-20 h-20 mx-auto mb-6 rounded-full bg-white/20 flex items-center justify-center"
                    >
                        <svg
                            class="w-10 h-10"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                            ></path>
                        </svg>
                    </div>

                    <h3 class="text-2xl font-bold mb-4">
                        ¡Agenda tu Cita Ahora!
                    </h3>

                    <p class="text-white/90 mb-6 leading-relaxed">
                        Escríbeme por WhatsApp para agendar tu cita. Respondo
                        rápido y te atiendo con mucho gusto.
                    </p>

                    <a
                        href={whatsappLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 bg-white text-pink-600 px-8 py-4 rounded-full font-semibold hover:bg-pink-50 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-1"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                            ></path>
                        </svg>
                        Escribir por WhatsApp
                    </a>

                    <p class="text-white/70 text-sm mt-6">
                        Respuesta en menos de 1 hora ⚡
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
